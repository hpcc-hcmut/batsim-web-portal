                      </Stack>
                      {exp.status === "running" && (
                        <LinearProgress
                          variant="determinate"
                          value={exp.progress_percentage}
                          sx={{
                            mt: 1,
                            height: 8,
                            borderRadius: 4,
                            background: "#23304a",
                          }}
                        />
                      )}
                    </CardContent>
                  </Card>
                </Grid>
              ))}
            </Grid>
          )}
        </Box>
      </Card>
    </Box>
  );
};

export default DashboardDemo;
