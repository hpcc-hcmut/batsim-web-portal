                  onClick={() => handleSort("file_size")}
                  sx={{ fontWeight: 700 }}
                >
                  Size
                </TableSortLabel>
              </TableCell>
              <TableCell>
                <TableSortLabel
                  active={sortField === "created_at"}
                  direction={sortField === "created_at" ? sortOrder : "asc"}
                  onClick={() => handleSort("created_at")}
                  sx={{ fontWeight: 700 }}
                >
                  Created
