        </Grid>
      </Grid>

      {/* Strategy Comparison */}
      <Card sx={{ p: 3, background: "rgba(26,32,44,0.98)", borderRadius: 2, mb: 3 }}>
        <Stack direction="row" alignItems="center" spacing={2} mb={2}>
          <Compare sx={{ color: "#4a9eff" }} />
          <Typography variant="h6" fontWeight={700}>
            Strategy Comparison
