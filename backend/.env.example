# Database (SQLite for dev, PostgreSQL for production)
DATABASE_URL=sqlite:///./batsim.db
# VM deploy: keep the DB under storage/ so backups + re-clones don't lose it:
# DATABASE_URL=sqlite:///./storage/batsim.db
# DATABASE_URL=postgresql://batsim:batsim@localhost:5432/batsim

# JWT
SECRET_KEY=change-this-to-a-random-secret-key
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# File Storage
STORAGE_PATH=./storage
MAX_FILE_SIZE=104857600
# Only set when backend runs inside a container (DooD): absolute HOST path
# corresponding to STORAGE_PATH inside the container. Leave unset for native/hybrid mode.
# Compose sets this automatically via ${PWD}/backend/storage.
# HOST_STORAGE_PATH=

# Docker — BatSim images
BATSIM_IMAGE=oarteam/batsim:latest
PYBATSIM_IMAGE=tanaxer/pybatsim:latest

# Simulation
MAX_CONCURRENT_SIMULATIONS=3
SIMULATION_TIMEOUT_SECONDS=3600
SIMULATION_DATA_PATH=./storage/experiments

# CORS
BACKEND_CORS_ORIGINS=["http://localhost:3000","http://localhost:5173","http://localhost:8080"]
