# VM deployment overrides. Copy to backend/.env on the VM and edit values.
# Only the values below need to change vs local dev; everything else has sane defaults.

# REQUIRED: random secret for JWT signing (generate: python -c "import secrets; print(secrets.token_hex(32))")
SECRET_KEY=CHANGE_ME_RANDOM_HEX

# REQUIRED: Grafana link the browser will open (VM IP or domain, not localhost)
GRAFANA_URL=http://VM_IP_OR_DOMAIN:3000

# Optional: extra CORS origins as a JSON array (only needed if the frontend is
# served from a different origin than the API; the built-in vite proxy keeps
# everything same-origin, so the default usually works)
# BACKEND_CORS_ORIGINS=["http://VM_IP_OR_DOMAIN:5173","http://localhost:5173"]

# Longer sessions are convenient for survey participants (minutes)
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Keep the SQLite DB under storage/ so it survives re-clone and is captured by a
# storage/ backup (default config.py puts it at the CWD root).
DATABASE_URL=sqlite:///./storage/batsim.db

# Extended PyBatsim image (adds numpy/scipy/pandas for ML strategies).
# Build once on the VM: docker build -t batsim-portal/pybatsim-extended:1.0 docker/pybatsim-extended/
PYBATSIM_IMAGE=batsim-portal/pybatsim-extended:1.0

# NOTE: Grafana admin password is a COMPOSE-level var (not read from this file).
# To change it, set GRAFANA_ADMIN_PASSWORD in the shell or a project-root
# batsim-web-portal/.env before `docker compose up` (defaults to "admin").
