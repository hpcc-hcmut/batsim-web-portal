<?xml version='1.0'?>
<!DOCTYPE platform SYSTEM "http://simgrid.gforge.inria.fr/simgrid/simgrid.dtd">
<platform version="4">
  <AS id="AS0" routing="Full">
    <cluster id="cluster0" prefix="node-" suffix=".test"
             radical="0-3" speed="1Gf" bw="125MBps" lat="50us"
             router_id="router0"/>

    <AS id="AS_master" routing="Full">
      <host id="master_host" speed="1Gf"/>
    </AS>

    <link id="backbone" bandwidth="125MBps" latency="0" sharing_policy="FATPIPE"/>

    <ASroute src="cluster0" dst="AS_master" gw_src="router0" gw_dst="master_host">
      <link_ctn id="backbone"/>
    </ASroute>
  </AS>
</platform>
